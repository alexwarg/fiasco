# vim:set ft=make:

OBJECTS_LIBUART-$(CONFIG_PF_EXYNOS_UART_NATIVE) += uart_s3c2410.o
OBJECTS_LIBUART         += $(OBJECTS_LIBUART-y)
LIBUART_UART_FLAGS-$(CONFIG_PF_EXYNOS_UART_NATIVE) += $(call LIBUART_UART, s3c2410, s5pv210)
LIBUART_UART_FLAGS   += $(LIBUART_UART_FLAGS-y)

CXXSRC_KERNEL-$(CONFIG_PF_EXYNOS_TIMER_MP) += timer_exynos_mptimer.cc
CXXSRC_KERNEL-$(CONFIG_PF_EXYNOS_TIMER_MCT) += timer_exynos_mct.cc timer_tick-exynos-mct.cc
CXXSRC_KERNEL-$(CONFIG_PF_EXYNOS_TIMER_PWM) += timer_arm_s3c2410.cc
CXXSRC_KERNEL += timer_mct.cc pfc-arm-exynos.cc exynos_pf.cc platform_arm_exynos.cc
CXXSRC_KERNEL-$(CONFIG_PF_EXYNOS_TICKLESS_IDLE) += exynos_tickless_idle.cc cpu_tickless_idle.cc

VPATH                   += kern/arm/bsp/s3c
RAM_PHYS_BASE           := $(if $(CONFIG_ARM_EM_TZ),0xb0000000,0x40000000)
MPCORE_PHYS_BASE        := 0x10500000

