# vim:set ft=make:

OBJECTS_LIBUART         += uart_pl011.o
LIBUART_UART_FLAGS      += $(call LIBUART_UART, pl011)

RAM_PHYS_BASE           := $(CONFIG_PF_REALVIEW_RAM_PHYS_BASE)

MPCORE_PHYS_BASE-$(CONFIG_PF_REALVIEW_VEXPRESS_A9)  := 0x1e000000
MPCORE_PHYS_BASE-$(CONFIG_PF_REALVIEW_VEXPRESS_A15) := 0x2c000000
MPCORE_PHYS_BASE        := $(if $(MPCORE_PHYS_BASE-y),$(MPCORE_PHYS_BASE-y),0x1f000000)

CXXSRC_KERNEL         += pfc-arm-realview.cc realview_pf.cc rv_platforms.cc platform_arm_realview.cc \
                         board_check-arm-realview.cc

CXXSRC_KERNEL-$(CONFIG_ARM_MPTIMER) +=  timer_realview_mptimer.cc
CXXSRC_KERNEL-$(CONFIG_ARM_SP804_TIMER) += timer_realview_sp804.cc
