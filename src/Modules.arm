# -*- makefile -*-
# vi:se ft=make:

###############################################################################

include $(srcdir)/Modules.generic

SUBSYSTEMS := 	ABI KERNEL LIBK DRIVERS MINILIBC LIBUART \
		CXXLIB VERSION JABI TCBOFFSET CRT0

ifeq ($(CONFIG_UNIT_TEST),y)
	# UTEST depends on KERNEL and CHECKSUM, must be listed after them
	SUBSYSTEMS += UTEST
endif


PREPROCESS_PARTS 	+= $(CONFIG_ABI) $(CONFIG_XARCH) libuart

ifeq ($(CONFIG_BIT64),y)
PREPROCESS_PARTS += 64bit arm_esr_traps
BITS := 64
else
PREPROCESS_PARTS += 32bit abs_syscalls
BITS := 32
endif

PREPROCESS_PARTS-$(CONFIG_JDB)                += debug log

PREPROCESS_PARTS-$(CONFIG_ARM_920T)                 += arm_v5 vcache
PREPROCESS_PARTS-$(CONFIG_ARM_926)                  += arm_v5 vcache
PREPROCESS_PARTS-$(CONFIG_CPU_VIRT)                 += vgic arm_esr_traps
PREPROCESS_PARTS-y$(CONFIG_CPU_VIRT)$(CONFIG_BIT64) += noncont_mem
PREPROCESS_PARTS-$(CONFIG_ARM_PT48)                 += arm_pt_48

BSP_NAME         := $(patsubst "%",%,$(CONFIG_BSP_NAME))
BSP_SRC_DIR      := kern/arm/bsp/$(BSP_NAME)
MODULES_FILE_BSP := $(srcdir)/$(BSP_SRC_DIR)/Modules
ifeq ($(wildcard $(MODULES_FILE_BSP)),)
  $(error No BSP name defined or no BSP Modules file available)
endif

PRIVATE_INCDIR += $(BSP_SRC_DIR)
VPATH += $(BSP_SRC_DIR)

#
# TYPES subsystem
#

PRIVATE_INCDIR += types/$(CONFIG_XARCH)/$(BITS) types/$(CONFIG_XARCH) types

VPATH_LIBUART  := $(srcdir)/lib/uart
PRIVATE_INCDIR += lib/uart

#
# DRIVERS Subsystem
#
DRIVERS 		:= libdrivers.a libgluedriverslibc.a
VPATH			+= drivers/$(CONFIG_XARCH)/$(BITS) drivers/$(CONFIG_XARCH) drivers
PRIVATE_INCDIR		+= drivers/$(CONFIG_XARCH)/$(BITS) drivers/$(CONFIG_XARCH) drivers
INTERFACES_DRIVERS 	:=  \
			   mem mmu processor
mmu_IMPL		:= mmu mmu-arm mmu-arm-$(BITS)
mem_IMPL		:= mem mem-arm
processor_IMPL		:= processor processor-arm-$(BITS) processor-arm
CXXSRC_DRIVERS		:= glue_libc.cc console.cc filter_console.cc mux_console.cc \
	delayloop.cc

NOOPT			+= $(patsubst %.o, %, $(OBJ_DRIVERS))
ALWAYS_INLINE           += mem

#
# LIBREGEX subsystem (only for Jdb)
#
LIBREGEX	:= libregex.a
VPATH		+= lib/regex
PRIVATE_INCDIR	+= lib/regex
CSRC_LIBREGEX	:= rx.c
NOOPT		+= $(patsubst %.o, %, $(OBJ_LIBREGEX))

#
# MINILIBC Subsystem
#
MINILIBC	:= libc.a
VPATH		+= lib/minilibc/$(CONFIG_XARCH)/$(BITS) lib/minilibc/$(CONFIG_XARCH) lib/minilibc
PRIVATE_INCDIR	+= lib/minilibc/$(CONFIG_XARCH)/$(BITS)/include lib/minilibc/$(CONFIG_XARCH)/include lib/minilibc/include
CSRC_MINILIBC	:= atexit.c memccpy.c memcmp.c memmove.c memset.c memcpy.c \
		   memchr.c panic.c strchr.c strrchr.c strcmp.c strcpy.c strlen.c \
		   strncmp.c strncpy.c strstr.c printf.c \
		   __v_printf.c vprintf.c strtol.c strtoul.c __lltostr.c \
		   __ltostr.c putchar.c puts.c getchar.c \
		   sprintf.c snprintf.c vsnprintf.c vsprintf.c \
		   longjmp.c isalnum.c isalpha.c isascii.c isblank.c \
		   iscntrl.c isdigit.c isgraph.c islower.c isprint.c \
		   ispunct.c isspace.c isupper.c isxdigit.c strspn.c \
		   strcspn.c tolower.c raise.c aeabi.c atexit-aeabi.c
ASSRC_MINILIBC	:= setjmp.S
NOBUILTIN	+= $(patsubst %.o, %, $(OBJ_MINILIBC))


#
# LIBGZIP subsystem (only for Jdb)
#
ifneq ($(CONFIG_JDB_GZIP),)
  LIBGZIP		:= libgzip.a
  VPATH		+= lib/gzip
  PRIVATE_INCDIR	+= lib/gzip
  CSRC_LIBGZIP	:= adler32.c crc32.c gzip.c trees.c deflate.c zutil.c
  NOOPT		+= $(patsubst %.o, %, $(OBJ_LIBGZIP))
  CFLAGS_adler32 = $(WNO_DEPRECATED_NON_PROTOTYPE)
  CFLAGS_crc32   = $(WNO_DEPRECATED_NON_PROTOTYPE) -Wno-strict-prototypes
  CFLAGS_deflate = $(WNO_DEPRECATED_NON_PROTOTYPE)
  CFLAGS_trees   = $(WNO_DEPRECATED_NON_PROTOTYPE) -Wno-strict-prototypes
  CFLAGS_zutil   = $(WNO_DEPRECATED_NON_PROTOTYPE) -Wno-strict-prototypes
endif


#
# JABI Subsystem
#
JABI			:= libjabi.a
VPATH			+= jabi/$(CONFIG_XARCH)/$(BITS) jabi/$(CONFIG_XARCH) jabi
INTERFACES_JABI		:= jdb_ktrace

#
# ABI Subsystem
#
PRIVATE_INCDIR	+= abi/$(CONFIG_XARCH) abi
ABI 		:= libabi.a
VPATH 		+= abi/$(CONFIG_XARCH)/$(BITS) abi/$(CONFIG_XARCH) abi


#
# KERNEL subsystem
#
KERNEL 		:= fiasco
KERNEL_EXTRA 	:= Symbols kernel.arm.lds fiasco.image
VPATH 		+= kern/$(CONFIG_XARCH)/$(BITS) kern/$(CONFIG_XARCH) kern
VPATH		+= jdb/arm/$(BITS) jdb/arm jdb
PRIVATE_INCDIR 	+= kern/$(CONFIG_XARCH)/$(BITS) kern/$(CONFIG_XARCH) kern

CXXSRC_KERNEL += main_arm.cc \
	task_vcpu_resume.cc \
	platform_iface.cc \
	thread_arm.cc \
	irq_chip_generic.cc \
	kmem_alloc-arm.cc \
	kmem_space_arm_$(BITS).cc \
	mem_space_arm.cc \
	entry_frame.cc \
	traps.cc \
	nested_trap_handler.cc \
	__main.cc \
	kernel_thread-arm.cc \
	pfc-arm.cc \
	vmem_alloc-arm.cc \
	startup-arm.cc \
	irq_entry_$(BITS).cc \
	mem_op.cc mem_op-arm-$(BITS).cc

CXXSRC_KERNEL-$(CONFIG_ARM_GENERIC_TIMER) += \
	arch_time_source-generic_timer.cc \
	timer_arm_generic.cc

CXXSRC_KERNEL-$(CONFIG_ARM_V6PLUS) += mem_space-arm-asid.cc

CXXSRC_KERNEL-$(CONFIG_CPU_VIRT) += task_arm_virt.cc vgic_global.cc hyp_ppi.cc
CXXSRC_KERNEL-$(CONFIG_MP) += \
	main_arm_mp.cc \
	arm_ipis.cc
CXXSRC_KERNEL-$(CONFIG_SERIAL) += uart_console.cc boot_uart_init.cc
CXXSRC_KERNEL-$(CONFIG_HAVE_ARM_GICV3) += gic_v3.cc gic_redist.cc
CXXSRC_KERNEL-$(CONFIG_ARM_GIC) += gic.cc pic-gic-helper.cc
CXXSRC_KERNEL-$(CONFIG_BIT32) += kern_lib_page.cc sys_call_page.cc kmem-arm-32.cc
CXXSRC_KERNEL-$(CONFIG_BIT64) += entry_cc.cc kmem-arm-64.cc
CXXSRC_KERNEL-$(CONFIG_ARM_SMC_USER) += smc_user.cc
CXXSRC_KERNEL-$(CONFIG_ARM_PSCI) += psci.cc
CXXSRC_KERNEL-$(CONFIG_ARM_CACHE_L2CXX0) += outer_cache-l2cxx0.cc

CXXSRC_KERNEL-$(CONFIG_ARM_EM_TZ) += vm.cc

CXXSRC_KERNEL += bootstrap.cc
CXXFLAGS_bootstrap      := -O3 -fno-implement-inlines -fvisibility=internal $(if $(CONFIG_BIT64),-mcmodel=large)

CXXSRC_KERNEL		+= cpu-arm.cc cpu-arm-hyp.cc
CXXSRC_KERNEL-$(CONFIG_BIT32) += cpu-arm-32.cc
mem_layout_IMPL		:= mem_layout mem_layout-arm-$(BITS) \
			   mem_layout-arm mem_layout-noncont
CXXSRC_KERNEL-$(CONFIG_PERF_CNT) += perf_cnt_arm_v7plus.cc perf_cnt_arm.cc


ifeq ("$(CONFIG_JDB)","y")
JDB			:= jdb_compound.o
SUBSYSTEMS		+= JDB
INTERFACES_JDB		+= jdb_ptab jdb_trace_set jdb_log jdb_perf \
			   jdb_console_buffer jdb_idle_stats

CXXSRC_JDB += tb_entry_output.cc


jdb_IMPL		+= jdb-arm
jdb_kern_info_IMPL	:= jdb_kern_info jdb_kern_info-arm \
			   jdb_kern_info-bench jdb_kern_info-bench-arm \
			   jdb_kern_info-cpu-arm
jdb_dump_entry_frame_IMPL:= jdb_dump_entry_frame-arm
jdb_tcb_IMPL		+= jdb_tcb-arm
jdb_ptab_IMPL		:= jdb_ptab jdb_ptab-ia32-arm jdb_ptab-arm
jdb_entry_frame_IMPL	:= jdb_entry_frame-arm
jdb_trace_set_IMPL	:= jdb_trace_set jdb_trace_set-arm \
			   jdb_trace_set-arm-$(BITS)
jdb_bp_IMPL		:= jdb_bp-arm

endif

ASSRC_KERNEL	  	:= $(if $(CONFIG_MP),tramp-mp.S)
ASSRC_KERNEL            += $(if $(CONFIG_BIT32),$(if $(CONFIG_CPU_VIRT),hvt.S,ivt.S),ivt.S)
CPPFLAGS                += $(if $(CONFIG_MP),-DMPCORE_PHYS_BASE=$(MPCORE_PHYS_BASE))
CPPFLAGS                += -DRAM_PHYS_BASE=$(RAM_PHYS_BASE)


NOOPT			+= $(filter jdb%,\
			     $(foreach in,$(INTERFACES_KERNEL), \
			       $(if $($(in)_IMPL),$($(in)_IMPL),$(in))))
NOOPT			+= tb_entry tb_entry_output


#
# CRT0 subsystem
#
CRT0 		:= crt0.o
ASSRC_CRT0	:= crt0.S


#
# LIBK subsystem
#
LIBK 		:= libk.a
VPATH          	+= lib/libk/$(CONFIG_XARCH)/$(BITS) lib/libk/$(CONFIG_XARCH) lib/libk lib/contrib/compiler-rt/lib/builtins/arm lib/contrib/compiler-rt/lib/builtins
PRIVATE_INCDIR 	+= lib/libk/$(CONFIG_XARCH)/$(BITS) lib/libk/$(CONFIG_XARCH) lib/libk

CXXSRC_LIBK     += construction.cc
ASSRC_LIBK-$(CONFIG_BIT32)  += \
	aeabi_uldivmod.S \
	aeabi_uidivmod.S \
	aeabi_idivmod.S \
	udivmoddi4.S \
	udivsi3.S \
	udivmodsi4.S \
	divmodsi4.S \
	divsi3.S

CSRC_LIBK-$(CONFIG_BIT32)   += ashldi3.c
ASSRC_LIBK += $(ASSRC_LIBK-y)
CSRC_LIBK  += $(CSRC_LIBK-y)

#
# SIMPLEMALLOC
#
SIMPLEMALLOC     := libsimple_malloc.a
VPATH             += lib/simple_malloc
PRIVATE_INCDIR    += lib/simple_malloc
CXXSRC_SIMPLEMALLOC = simple_malloc.cc

ifeq ("$(CONFIG_JDB_DISASM)","y")
  # $(srcdir)/lib/disasm may be removed
  ifeq ($(wildcard $(srcdir)/lib/disasm),)
    $(error $(srcdir)/lib/disasm is missing, disable CONFIG_JDB_DISASM)
  endif
  SUBSYSTEMS          += LIBDISASM
  KERNEL_EXTRA_LIBS   += $(LIBDISASM)
  PREPROCESS_PARTS    += jdb_disasm

  LIBDISASM           := libdisasm.a
  VPATH               += lib/disasm lib/disasm/capstone
  PRIVATE_INCDIR      += lib/disasm lib/disasm/capstone/include
  CXXSRC_LIBDISASM    := disasm.cc
  CSRC_LIBDISASM      := cs.c utils.c \
                         MCInst.c MCInstrDesc.c MCRegisterInfo.c SStream.c
  ifeq ("$(CONFIG_BIT32)","y")
    VPATH             += lib/disasm/capstone/arch/ARM
    CSRC_LIBDISASM    += ARMModule.c ARMInstPrinter.c \
			 ARMDisassembler.c ARMMapping.c
    CPPFLAGS          += -DCAPSTONE_HAS_ARM
    CFLAGS_ARMDisassembler = -Wno-unused-parameter
    CFLAGS_ARMMapping      = -Wno-unused-parameter
    CFLAGS_ARMInstPrinter  = -Wno-bad-function-cast -Wno-unused-parameter
    $(foreach f, $(patsubst %.c, %, $(CSRC_LIBDISASM)), \
      $(eval CFLAGS_$(f) += -mno-unaligned-access))
  else
    VPATH             += lib/disasm/capstone/arch/AArch64
    CSRC_LIBDISASM    += AArch64Module.c AArch64InstPrinter.c \
			 AArch64Disassembler.c AArch64Mapping.c \
			 AArch64BaseInfo.c
    CPPFLAGS          += -DCAPSTONE_HAS_ARM64
    CFLAGS_AArch64Mapping      = -Wno-unused-parameter
    CFLAGS_AArch64Disassembler = -Wno-unused-parameter
    CFLAGS_AArch64InstPrinter  = -Wno-bad-function-cast -Wno-unused-parameter
  endif
endif

ifeq ("$(CONFIG_JDB)","y")

ifneq ($(CONFIG_JDB_GZIP),)
 ifneq ($(wildcard $(srcdir)/lib/gzip),)
  SUBSYSTEMS		+= LIBGZIP
  KERNEL_EXTRA_LIBS	+= $(LIBGZIP)
  INTERFACES_KERNEL	+= jdb_gzip
 endif
endif

ifneq ($(wildcard $(srcdir)/lib/regex),)
  SUBSYSTEMS            += LIBREGEX
  KERNEL_EXTRA_LIBS     += $(LIBREGEX)
  PREPROCESS_PARTS      += jdb_regex
endif

ifneq ($(filter LIBREGEX LIBDISASM,$(SUBSYSTEMS)),)
  SUBSYSTEMS          += SIMPLEMALLOC
  KERNEL_EXTRA_LIBS   += $(SIMPLEMALLOC)
endif

endif

#
# VERSION subsystem
#
VERSION		:= version.h

TCBOFFSET	:= tcboffset.h
CXXSRC_TCBOFFSET	:= tcboffset.cc dump_tcboffsets.cc


include $(MODULES_FILE_BSP)
PREPROCESS_PARTS	+= $(PREPROCESS_PARTS-y)
INTERFACES_KERNEL       += $(INTERFACES_KERNEL-y) $(INTERFACES_KERNEL-y-y)
INTERFACES_JDB		+= $(INTERFACES_JDB-y)
TRAMP_MP_ASM_INCLUDE    ?= kern/arm/tramp-mp-asm-default.h
CPPFLAGS                += -DTRAMP_MP_ASM_INCLUDE=\"$(srcdir)/$(TRAMP_MP_ASM_INCLUDE)\"

ifeq ("$(filter LIBUART, $(SUBSYSTEMS))","LIBUART")
  LIBUART			:= uart/libuart.a
endif

CONFIG_KERNEL_LOAD_ADDR := $(RAM_PHYS_BASE)

ifneq ($(CONFIG_MP),)
ifneq ($(CONFIG_ARM_MPCORE)$(CONFIG_ARM_CORTEX_A9)$(CONFIG_ARM_CORTEX_A5),)
ifeq ($(MPCORE_PHYS_BASE),)
$(error $(MODULES_FILE_BSP) needs to set MPCORE_PHYS_BASE variable)
endif
endif
endif

ifneq ($(CONFIG_CPU_VIRT),)
  ifeq ($(CC_TYPE),gcc)
    ifeq ($(findstring $(CCVER_MAJOR),0 1 2 3),)
      ifeq ($(CCVER_MAJOR),4)
	ARM_CC_OK_FOR_VIRT := $(if $(findstring $(CCVER_MINOR),0 1 2 3 4 5 6),,y)
      else
        ARM_CC_OK_FOR_VIRT := y
      endif
    endif
  endif
  ifeq ($(CC_TYPE),clang)
    ifeq ($(findstring $(CCVER_MAJOR),0 1 2 3 4 5 6),)
      ARM_CC_OK_FOR_VIRT := y
    else
      $(shell touch buildcheck.ignore)
      $(error At least Clang 7 required for compiling Fiasco with virtualization enabled)
    endif
  endif

  ifeq ($(ARM_CC_OK_FOR_VIRT),)
    $(shell touch buildcheck.ignore)
    $(error At least GCC 4.7 required for compiling Fiasco with virtualization enabled)
  endif
endif

MODULES_FILES += $(MODULES_FILE) $(MODULES_FILE_BSP)
