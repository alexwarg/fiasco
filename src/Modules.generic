# -*- makefile -*-
# vi:se ft=make:

# Include for unit tests, enable by including UTEST in SUBSYSTEMS.
include $(srcdir)/test/utest/Modules.utest
#
# CXXLIB Subsystem
# 
CXXLIB 			:= libcxx.a
VPATH			+= lib/cxxlib
CXXSRC_CXXLIB 		+= paranoia.cc

CXXSRC_ABI += kip.cc

CXXSRC_ABI-$(CONFIG_JDB) += \
	l4_types_dbg.cc l4_error_dbg.cc kip_dbg.cc

CXXSRC_ABI += $(CXXSRC_ABI-y)

PREPROCESS_PARTS-$(CONFIG_JDB_LOGGING)       += jdb_logging

CXXSRC_KERNEL += \
	cpu_generic.cc \
	banner.cc \
	pfc.cc \
	boot_alloc.cc \
	config.cc \
	config_arch.cc \
	context.cc \
	context_drq.cc \
	cpu_call.cc \
	cpu_lock.cc \
	factory.cc \
	globals.cc \
	helping_lock.cc \
	ipc_gate.cc \
	ipc_timeout.cc \
	irq.cc \
	irq_chip.cc \
	irq_mgr.cc \
	kernel_console.cc \
	kernel_panic.cc \
	kernel_task.cc \
	kernel_thread-std.cc \
	kernel_thread.cc \
	kip_init.cc \
	kmem_alloc.cc \
	kmem_slab.cc \
	kmem.cc \
	kobject.cc \
	kobject_helper.cc \
	kobject_iface.cc \
	koptions.cc \
	libc_backend_lock.cc \
	mapdb.cc \
	mapping_tree.cc \
	map_util_mem.cc \
	map_util_objs.cc \
	map_util.cc \
	mem_space_base.cc \
	pm.cc \
	platform_control_object.cc \
	ram_quota.cc \
	rcupdate.cc \
	receiver.cc \
	sched.cc \
	sched_context.cc \
	scheduler.cc \
	scheduler_iface.cc \
	semaphore.cc \
	slab_cache.cc \
	space.cc \
	syscalls.cc \
	task.cc \
	terminate.cc \
	thread.cc \
	thread_object.cc \
	timeout.cc \
	timeslice_timeout.cc \
	trap_state.cc \
	vlog.cc \

CXXSRC_KERNEL-$(CONFIG_FPU) += fpu_alloc.cc fpu.cc fpu_arch.cc
CXXSRC_KERNEL-$(CONFIG_MP) += per_cpu_data_mp.cc per_cpu_data_alloc.cc \
			      app_cpu_thread.cc ipi.cc \
			      context_mp.cc

CXXSRC_KERNEL-$(CONFIG_SERIAL) += kernel_uart.cc vkey_serial.cc
CXXSRC_KERNEL-a$(CONFIG_SERIAL) += vkey_noserial.cc
CXXSRC_KERNEL-y$(CONFIG_PERF_CNT) += perf_cnt_dummy.cc

CXXFLAGS_kernel_uart = $(LIBUART_UART_FLAGS)

CXXSRC_KERNEL-$(CONFIG_JDB) += \
	syscalls-log.cc \
	dbg_page_info.cc kobject_dbg.cc assertion-dbg.cc jdb_object.cc \
	tb_entry_generic.cc \
	drq_log.cc vcpu_log.cc context_dbg.cc exregs_log.cc \
	dbg_stack.cc

#CXXSRC_KERNEL-y$(CONFIG_JDB) += assertion.cc
CXXSRC_KERNEL += $(CXXSRC_KERNEL-y)
CXXSRC_KERNEL += $(CXXSRC_KERNEL-y-y)

CXXFLAGS_K_SCHED_CONTEXT-$(CONFIG_SCHED_FIXED_PRIO) := -DSCHED_CONTEXT_IMPL='"sched_context_fp.h"'
CXXFLAGS_K_SCHED_CONTEXT-$(CONFIG_SCHED_WFQ)        := -DSCHED_CONTEXT_IMPL='"sched_context_wfq.h"'
CXXFLAGS_K_SCHED_CONTEXT-$(CONFIG_SCHED_FP_WFQ)     := -DSCHED_CONTEXT_IMPL='"sched_context_fp_wfq.h"'

CXXFLAGS += $(CXXFLAGS_K_SCHED_CONTEXT-y)


OBJ_SPACE_TYPE = $(if $(CONFIG_VIRT_OBJ_SPACE),virt,phys)
PREPROCESS_PARTS-y$(CONFIG_VIRT_OBJ_SPACE) += obj_space_phys
PREPROCESS_PARTS += obj_space_$(OBJ_SPACE_TYPE)

VPATH_JDB += jdb
PRIVATE_INCDIR += jdb

INTERFACES_JDB += \
	jdb jdb_util jdb_core jdb_module jdb_prompt_ext            \
	jdb_handler_queue jdb_attach_irq jdb_entry_frame                   \
	jdb_exit_module jdb_bp jdb_factory jdb_input jdb_ipc_gate          \
	jdb_kobject jdb_kobject_names jdb_prompt_module                    \
	jdb_obj_space jdb_screen jdb_space jdb_table jdb_tcb               \
	jdb_thread jdb_thread_list jdb_counters      \
	jdb_regex jdb_disasm jdb_tbuf_output jdb_input_task jdb_tbuf_show  \
	jdb_report jdb_dump jdb_mapdb jdb_timeout jdb_kern_info_kmem_alloc \
	jdb_kern_info_kip jdb_kern_info jdb_kern_info_data jdb_utcb        \
	jdb_trap_state jdb_rcupdate jdb_sender_list                        \
	jdb_ipi

jdb_IMPL	+= jdb jdb-ansi jdb-thread
jdb_tbuf_IMPL	+= jdb_tbuf jdb_tbuf-$(CONFIG_XARCH)
jdb_tcb_IMPL	+= jdb_tcb

CXXSRC_JDB += kern_cnt.cc push_console.cc jdb_list.cc
CXXSRC_JDB-$(CONFIG_MP) += jdb_cpu_call.cc

CXXSRC_JDB += $(CXXSRC_JDB-y) $(CXXSRC_JDB-yy) $(CXXSRC_JDB-y-y)


ifeq ("$(CONFIG_JDB)","y")
INTERFACES_KERNEL += \
	jdb_tbuf jdb_tbuf_init jdb_trace
endif

# - do not profile all of MINILIBC, because it is used in the BOOT subsystem
# - save some space for debugger, disassembler, ...
NOOPT			+= $(patsubst %.o, %,\
			   $(OBJ_MINILIBC) $(OBJ_JDB) $(OBJ_LIBDISASM))

# Helper function to generate CXXFLAGS_uart-libuart
LIBUART_UART = -include uart_$(strip $(1)).h \
	       -DFIASCO_UART_TYPE=L4::Uart_$(strip $(if $(2),$(2),$(1)))

