    __atomic_store_n(ptr, v, (int)order);
  }


  template<typename T_>
  class atomic
  {
  private:
    static constexpr int _min_align
      = (sizeof(T_) & (sizeof(T_) - 1)) || sizeof (T_) > 16
      ? 0 : sizeof(T_);
    static constexpr int _align
      = _min_align > alignof(T_) ? _min_align : alignof(T_);

    alignas(_align) T_ v_;

  public:
    using value_type = T_;

    atomic() = default;
    ~atomic() noexcept = default;
    atomic(atomic const &) = delete;
    atomic(atomic &&) = delete;

    atomic &operator = (atomic const &) = delete;
    atomic &operator = (atomic const &) volatile = delete;
    atomic &operator = (atomic &&) = delete;
    atomic &operator = (atomic &&) volatile = delete;

    constexpr atomic(T_ v) noexcept : v_(v) {}

    T_ load(memory_order order = memory_order_seq_cst) const noexcept
    {
      alignas(T_) unsigned char _b[sizeof(T_)];
      T_ *_p = reinterpret_cast<T_*>(_b);
      __atomic_load(&v_, _p, (int)order);
      return *_p;
    }

    T_ load(memory_order order = memory_order_seq_cst) const volatile noexcept
    {
      alignas(T_) unsigned char _b[sizeof(T_)];
      T_ *_p = reinterpret_cast<T_*>(_b);
      __atomic_load(&v_, _p, (int)order);
      return *_p;
    }

    void store(T_ desired, memory_order order = memory_order_seq_cst) noexcept
    {
      __atomic_store(&v_, &desired, (int)order);
    }

    void store(T_ desired, memory_order order = memory_order_seq_cst) volatile noexcept
    {
      __atomic_store(&v_, &desired, (int)order);
    }

    T_ operator = (T_ desired) noexcept
    {
      store(desired);
      return v_;
    }

    T_ operator = (T_ desired) volatile noexcept
    {
      store(desired);
      return v_;
    }

    operator T_ () const noexcept
    {
      return load();
    }

    operator T_ () const volatile noexcept
    {
      return load();
    }


    T_ exchange(T_ desired, memory_order order = memory_order_seq_cst) noexcept
    {
      alignas(T_) unsigned char _b[sizeof(T_)];
      T_ *_r = reinterpret_cast<T_ *>(_b);
      __atomic_exchange(&v_, &desired, _r, (int)order);
      return *_r;
    }

    T_ exchange(T_ desired, memory_order order = memory_order_seq_cst) volatile noexcept
    {
      alignas(T_) unsigned char _b[sizeof(T_)];
      T_ *_r = reinterpret_cast<T_ *>(_b);
      __atomic_exchange(&v_, &desired, _r, (int)order);
      return *_r;
    }

    bool compare_exchange_weak(T_ &expected, T_ desired,
                               memory_order success,
                               memory_order failure) noexcept
    {
      return __atomic_compare_exchange(&v_, &expected, &desired, true, (int)success, (int)failure);
    }

    bool compare_exchange_weak(T_ &expected, T_ desired,
                               memory_order order = memory_order_seq_cst) noexcept
    {
      return compare_exchange_weak(expected, desired, order, memory_order_failure(order));
    }

    bool compare_exchange_weak(T_ &expected, T_ desired,
                               memory_order success,
                               memory_order failure) volatile noexcept
    {
      return __atomic_compare_exchange(&v_, &expected, &desired, true, (int)success, (int)failure);
    }

    bool compare_exchange_weak(T_ &expected, T_ desired,
                               memory_order order = memory_order_seq_cst) volatile noexcept
    {
      return compare_exchange_weak(expected, desired, order, memory_order_failure(order));
    }

    bool compare_exchange_strong(T_ &expected, T_ desired,
                                 memory_order success,
                                 memory_order failure) noexcept
    {
      return __atomic_compare_exchange(&v_, &expected, &desired, false, (int)success, (int)failure);
    }

    bool compare_exchange_strong(T_ &expected, T_ desired,
                                 memory_order order = memory_order_seq_cst) noexcept
    {
      return compare_exchange_strong(expected, desired, order, memory_order_failure(order));
    }

    bool compare_exchange_strong(T_ &expected, T_ desired,
                                 memory_order success,
                                 memory_order failure) volatile noexcept
    {
      return __atomic_compare_exchange(&v_, &expected, &desired, false, (int)success, (int)failure);
    }

    bool compare_exchange_strong(T_ &expected, T_ desired,
                                 memory_order order = memory_order_seq_cst) volatile noexcept
    {
      return compare_exchange_strong(expected, desired, order, memory_order_failure(order));
    }

    T_ fetch_add(T_ a, memory_order order = memory_order_seq_cst) noexcept
    {
      return __atomic_fetch_add(&v_, a, (int)order);
    }

    T_ fetch_add(T_ a, memory_order order = memory_order_seq_cst) volatile noexcept
    {
      return __atomic_fetch_add(&v_, a, (int)order);
    }

    T_ fetch_sub(T_ a, memory_order order = memory_order_seq_cst) noexcept
    {
      return __atomic_fetch_sub(&v_, a, (int)order);
    }

    T_ fetch_sub(T_ a, memory_order order = memory_order_seq_cst) volatile noexcept
    {
      return __atomic_fetch_sub(&v_, a, (int)order);
    }

    T_ add_fetch(T_ a, memory_order order = memory_order_seq_cst) noexcept
    {
      return __atomic_add_fetch(&v_, a, (int)order);
    }

    T_ add_fetch(T_ a, memory_order order = memory_order_seq_cst) volatile noexcept
    {
      return __atomic_add_fetch(&v_, a, (int)order);
    }

    T_ sub_fetch(T_ a, memory_order order = memory_order_seq_cst) noexcept
    {
      return __atomic_sub_fetch(&v_, a, (int)order);
    }

    T_ sub_fetch(T_ a, memory_order order = memory_order_seq_cst) volatile noexcept
    {
      return __atomic_sub_fetch(&v_, a, (int)order);
    }

    T_ operator += (T_ a) noexcept
    {
      return __atomic_add_fetch(&v_, a, (int)memory_order_seq_cst);
    }

    T_ operator -= (T_ a) noexcept
    {
      return __atomic_sub_fetch(&v_, a, (int)memory_order_seq_cst);
    }

  };
}

